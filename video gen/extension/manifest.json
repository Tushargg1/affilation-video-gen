{
  "manifest_version": 3,
  "name": "Digen AI Automation",
  "version": "1.0",
  "description": "Automate video generation on Digen AI",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://digen.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://digen.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
